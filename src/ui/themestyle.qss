{
	background-color: #ffc45d;
	color: #002f86;
}

QMenu::item:selected:!enabled[IsPageMenu=true]
{
	color: rgba(102, 102, 102, 255);
}

QMenu::item:!enabled[IsPageMenu=true]
{
	color: rgba(102, 102, 102, 255);
}

QMenu::item:checked[IsPageMenu=true]
{
	background-color: #fff3dd;
}

QMenu::indicator[IsPageMenu=true]
{
	background-color: #fff3dd;
}

QMenu::indicator:exclusive:checked:selected[IsPageMenu=true]
{
	background-color: #fff3dd;
}

QMenu::right-arrow[IsPageMenu=true]
{
	image:url();
}

QMenu::right-arrow:selected[IsPageMenu=true]
{
	image:url(theme/huaru/whiteblue/menu_right_arrow.png);
	padding-right:5px;
}

QMenu[IsPageMenu=false]
{
	background-color: #ffffff;
	alternate-background-color: #f0f3f8;
	border: 1px solid #a0b3c0;
	font:bold 16px;
	font-family:"Microsoft YaHei UI";
	color: #002f86;
}

QMenu::item[IsPageMenu=false]
{
	padding-left:40px;
	min-width:134px;
	max-width:134px;
	min-height:36px;
	max-height:36px;
	
	padding-top:0px;
	padding-bottom:0px;
	padding-right:0px;
}

QMenu::icon[IsPageMenu=false]
{
	min-height:22px;
}

QMenu::item:selected:enabled[IsPageMenu=false]
{
	background-color: #ffc45d;
	color: #002f86;
}

QMenu::item:selected:!enabled[IsPageMenu=false]
{
	background-color: #ffffff;
	color: #768ba5;
}

QMenu::item:!enabled[IsPageMenu=false]
{
	background-color: #ffffff;
	color: #768ba5;
}

QMenu::item:checked[IsPageMenu=true]
{
	background-color: #fff3dd;
}

QMenu::indicator[IsPageMenu=true]
{
	background-color: #fff3dd;
}

QMenu::indicator:exclusive:checked:selected[IsPageMenu=true]
{
	background-color: #fff3dd;
}


