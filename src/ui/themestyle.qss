HRSimResourceManagerWidget QTreeView#treeView_Resource
{
	background-color: #ffffff;
	alternate-background-color: #f0f3f8;
}

/*==============================QTreeView需要交替色的结束==============================================*/

QWidget#qt_calendar_navigationbar *,QWidget#qt_calendar_navigationbar
