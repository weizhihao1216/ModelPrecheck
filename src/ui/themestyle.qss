}

HRRTMDataTranslate #widget_status,
HRTranslateDialog #widget_status
{
	border:0px;
	background:#dfe5ef;
}

HRModelBoxFilterWidget QLineEdit
{
	background:#ffffff;
	height:26px;
	border:1px solid #d0d8e2;
	color:#a7b8ce; 
