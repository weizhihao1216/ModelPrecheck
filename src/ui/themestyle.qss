QWidget
{
    background-color:#f0f4f7;
	border-color: #dae1ee;
	color:#003986;
	font-family:"Microsoft YaHei UI";
}
/*去掉焦点虚线框*/
QWidget:focus
{
	outline:none;
}

QMenu
{
	background-color: #ffffff;
	alternate-background-color: #f0f3f8;
	border: 1px solid #a0b3c0;
	font-size:14px;
	font-family:"微软雅黑";
	color: #002f86;
	padding-top:0px;
	padding-bottom:0px;
}

QMenu::item
{
	padding-right:28px;
	padding-left:40px;
	min-width:100px;
	max-width:200px;
	height:28px;
}

QMenu::separator
{
	height:1px;
	background-color:#dbdbdb;
}

QMenu::icon
{
	position:absolute;
	left:16px;
	width:16px;
	height:16px;
}

QMenu::item:selected:enabled
{
	background-color: rgb(255,196,93);
	color: #002f86;
}

QMenu::item:selected:!enabled
{
	color:rgb(102,102,102);
}

QMenu::item:!enabled
{
	color:rgb(102,102,102);
}

QToolBar
{
	background-color:#001d43;
}

QToolBar::separator:vertical
{
	height:1px;
	background-color:#232d2e;
}

QToolBar::separator:horizontal
{
	width:1px;
	background-color:#232d2e;
}

QAbstractScrollArea
{
/* 	background-color: rgb(30, 30, 30); */
}
/* ==============================QLabel部分-开始======================================*/
/*QLabel字体及颜色*/
QLabel
{
	padding-bottom:3px;
	/*font-family:"微软雅黑";*/
	font-size:16px;
	color:#002f86;
	background: transparent;
}
/*禁用状态字体颜色*/
QLabel:disabled
{
	color:#002f86;
}
/*链接样式*/
QLabel#label_linktemplate
{
	font-size:12px;
	color: #007acc;
}
QLabel#label_linktemplate:hover
{
	color: #30abfe;
}
/*配置对话框添加分组虚线*/
QLabel#linelabel
{
	border-top:15px solid #373737;
	background-image:url(theme/huaru/grayblue/hline.png);
	background-repeat:repeat-x;
}

/* ==============================QLabel部分-结束=======================================*/
QToolTip
{
	background-color: rgb(226, 236, 249);
	color:#002f86;
	border:1px solid rgb(226, 236, 249);
}
HRMessageBox,HRMessageBox *
{
	font-family:"微软雅黑";
	font-size:13px;
}

/* ==============================QPushButton部分-开始===================================*/
QPushButton
{
	background-color: rgba(223, 235, 250, 255);
	color: rgba(0, 15, 44, 255);
	
	border-radius: 0px;
	border:1px solid rgba(202, 219, 245, 255);
	font: 14px;
	width:72px;
	min-height:24px;
}
QPushButton:hover
{
	background-color: #ffd98e;
	color: #3b2600;
	
	border-radius: 0px;
	border:1px solid #ecb017;
	font: 14px;
}
QPushButton:pressed
{
	background-color: #ffd98e;
	color: #3b2600;
	
	border-radius: 0px;
	border:1px solid #ecb017;
	font: 14px;
}
QPushButton:!enabled
{
	background-color: #f1f5f8;
	color: #8c9097;
	
	border-radius: 0px;
	border:1px solid #cacaca;
	font: 14px;
}

/* ==============================QPushButton部分-结束====================================*/


QToolButton
{
	background-color: #d5e5fa;
	border:0px solid #97c1ff;
	color:#002f86;
}

QToolButton:hover
{
	background-color: #e58900;
	border:0px solid #ecb017;
}


/* ==============================QTableView部分-开始===================================*/
/*默认状态*/
/*（如果要想使交替行变色起作用就需要设置ui->tableWidget->setAlternatingRowColors(true)
  或者在UI设计师界面勾选alternatingRowColors）；表格行与列的平分需要设置ui->tableWidget->horizontalHeader()->setResizeMode(QHeaderView::Stretch);
	ui->tableWidget->verticalHeader()->setResizeMode(QHeaderView::Stretch);去除虚线框需要设置ui->tableWidget->setFocusPolicy(Qt::NoFocus);*/
/*默认状态下表格属性，边框、背景色，字体及字体颜色、交替行变色*/
QTableView
{
	font-size: 14px;
	show-decoration-selected:1;
	background-color: #ffffff;
	alternate-background-color: #f0f3f8;
	border: 1px solid #dee6ee;
	color:#002f86;
	selection-background-color: #ffd178;
	gridline-color:#dee6ee;
}

 /*设置QTableView的表头颜色、表头字体大小，表头边框的隐藏*/
QTableView>QHeaderView
{
	background-color: transparent;/*没有数据的列表头颜色与背景色一致*/
}

QTableView>QHeaderView::section
{
	border:1px solid #599ae8;
	background-color: #e1effe;
	color: #002f86;
	
	border-top: 1px #dee6f3;
	border-left: 0px;
	font: 13px;
}
/*设置行表头高度，背景颜色及边框设置*/
QTableView>QHeaderView::section:horizontal
{
	font-size:16px;
	height:28px;
	border-right:1px solid #599ae8;
	border-bottom:2px solid #68a3ea;
}

QTableView >QHeaderView::section:first 
{
	border-left: 0px solid #599ae8;
}

QTableView >QHeaderView::section:last 
{
	border-right: 0px solid #599ae8;
}

/*列表头宽度，边框及背景色设置*/
QTableView>QHeaderView::section:vertical
{
	height:26px;
}

QTableView>QHeaderView::down-arrow 
{
	image: url(theme/huaru/skyblue/mainwidget_downarrow_normal.png);
}

QTableView>QHeaderView::up-arrow 
{
	image: url(theme/huaru/skyblue/mainwidget_uparrow_normal.png);
}

QTableView>QHeaderView::down-arrow:hover 
{
	image: url(theme/huaru/skyblue/mainwidget_downarrow_hover.png);
}

QTableView>QHeaderView::up-arrow:hover
{
	image: url(theme/huaru/skyblue/mainwidget_uparrow_hover.png);
}

/*QTableCornerButton背景及边框颜色设置，QTableCornerButton要想设置背景色必须要先给border设置属性，因为默认状态下它会吸引本地边框的背景颜色完全重叠*/
QTableView QTableCornerButton::section
{
	border:1px solid #599ae8;
	border-bottom:2px solid #599ae8;
	border-right:0px solid #599ae8;
	background-color: #e1effe;
}
/*设置表格focus状态下的背景颜色与选中时背景色一致，来去掉表格虚线框；配合 QWidget:focus，只写QWidget:focus对表格item不起作用*/

QTableView::item
{
	height:28px;
	color:#003986;
	border:0px solid rgba(222, 230, 238, 255);
	border-top:0px solid #dee6ee;
	border-right:0px solid #dee6ee;
	padding-left:6px;
}

 /*设置鼠标悬停时的状态,只能改变单元格颜色*/
QTableView::item:!selected:hover
{
	background-color: #ffd178;
	border-left: 0px solid transparent;
	border-right: 0px solid transparent;
}

QTableView::item:selected,QTableView::branch:selected  
{
	background: #ffd178;
	border-left: 0px solid transparent;
	border-right: 0px solid transparent;
}

QTableView::item:!enabled
{
	height: 29px;
	color:#a4a9b3;
}

/* Item 勾选框交由 Fusion 默认绘制，不在此覆盖 indicator */

QTableView>QHeaderView::down-arrow 
{
	image: url(theme/huaru/whiteblue/mainwidget_downarrow_normal.png);
}

QTableView>QHeaderView::up-arrow 
{
	image: url(theme/huaru/whiteblue/mainwidget_uparrow_normal.png);
}

QTableView>QHeaderView::down-arrow:hover 
{
	image: url(theme/huaru/whiteblue/mainwidget_downarrow_hover.png);
}

QTableView>QHeaderView::up-arrow:hover
{
	image: url(theme/huaru/whiteblue/mainwidget_uparrow_hover.png);
}

QTableView QComboBox
{
	border:0px solid #dee6ee;
}

QTableView QSpinBox
{
	border:0px solid #dee6ee;
}
/* ==============================QTableView部分-结束===================================*/

/* ==============================QListView部分-开始===================================*/
QListView
{
	font-size: 16px;
	show-decoration-selected:1;
	background-color: rgba(251,252,253,255); 
	alternate-background-color: #f0f3f8;
	border: 1px solid #dee6ee;
	color:#002f86; 
}

QListView:disabled
{
	background-color:rgb(47,47, 47);
	border: 1px solid #687069;
} 

QListView:!enabled
{
	background-color: transparent;
	border: 1px solid #dee6ee;
}

QListView::item
{
	height:29px;
	margin-top:1px;
	padding-left:14px;
	border: 0px solid #dee6ee;
	/* border-bottom: 1px solid #dee6ee; */
}

QListView::item:!enabled
{
	height:29px;
	color:#a4a9b3;
	padding-left:1px;
	border: 0px solid #dee6ee;
	/* border-bottom: 1px solid #dee6ee; */
} 

QListView::item:hover
{
	background: #ffd178;
	color:#002f86;
	border: 1px solid #ffd178;
	border-left: 0px solid transparent;
	border-right: 0px solid transparent;
}

QListView::item:selected
{
	background-color: #ffc45d;
	color:#002f86;
	border: 1px solid #ffc45d;
	border-left: 0px solid transparent;
	border-right: 0px solid transparent;
} 

/*设置表格focus状态下的背景颜色与选中时背景色一致，来去掉表格虚线框；配合 QWidget:focus，只写QWidget:focus对表格item不起作用*/
QListView::item:focus
{
	background-color: #ffc45d;
}
 /*设置鼠标悬停时的状态,只能改变单元格颜色*/
QListView::item:!selected:hover
{
	background-color: #ffd178;
}

/* Item 勾选框交由 Fusion 默认绘制，不在此覆盖 indicator */
/* ==============================QListView部分-结束===================================*/

/* ==============================QComboBox部分-开始===================================*/
/*QComboBox通用部分：主要出现在弹出窗体中*/
/*可用状态，设置高度、背景色、文字颜色、无边框*/
QComboBox
{
	background-color: #fbfdff;
	border:1px solid #a3b4cb;
	min-height:26px;
	padding-left:3px;
	font-size: 14px;
	font-family:"微软雅黑";
	color:#56667f;
}
/*禁用状态，设置背景色*/
QComboBox:disabled
{
	border:1px solid #e1e6e8;
	background-color:rgba(241, 243, 245, 127);
}
QComboBox:focus
{
	border:1px solid #1f84ff;
	background-color:#ffffff;
}

QComboBox::hover
{
	border:1px solid #1f84ff;
	background-color:#ffffff;
}

/*点击组合框文字部分，下拉菜单出现时，组合框边框变色*/
QComboBox:!editable:on
{
	border:1px solid #1f84ff;
	border-bottom:2px;
}
/*下拉箭头为图片*/
QComboBox::drop-down
{
	padding-top:5px;
	padding-right:5px;
    image:url(theme/huaru/whiteblue/icons/下拉按钮--正常.png);
}
/*点击下拉箭头，下拉菜单出现时，箭头无边框*/
QComboBox::drop-down:!editable:pressed
{
	
}
/*鼠标经过状态下拉箭头图片*/
QComboBox::drop-down:hover
{
	padding-top:5px;
	padding-right:5px;
	image:url(theme/huaru/whiteblue/icons/下拉按钮--滑过.png);
}

/*禁用状态下拉箭头图片*/
QComboBox::drop-down:disabled
{
	padding-top:5px;
	padding-right:5px;
	image:url(theme/huaru/whiteblue/icons/下拉按钮--禁用.png);
}
/*主窗体上的ComboBox的样式，“#comboBox_Column”表示一个指定的对象，“#”后名称的需要根据实际修改*/
/*可用状态，边框为图片*/
QComboBox#comboBox_Column
{
	height:21px;
	width:96px;	
	border-width:2px 1px 1px 2px;
	border-image: url(theme/huaru/whiteblue/mainwidget_pushbutton_normal.png) 2 1 1 2 repeat repeat; 
	color: #f3f7fc;
}

/*点击组合框文字部分，下拉菜单出现时，组合框边框为图片*/
QComboBox#comboBox_Column:!editable:on
{
	border-width:1px 1px 1px 1px;
	border-image: url(theme/huaru/whiteblue/mainwidget_combobox_hover.png) 2 1 1 2 repeat repeat; 
}
/*点击下拉箭头，下拉菜单出现时，箭头无边框*/
QComboBox#comboBox_Column::drop-down:!editable:pressed
{
	border:0;
}

QComboBox QAbstractItemView
{
	background-color:#ffffff;
	color:#243c59; 
}

QComboBox QAbstractItemView::item
{
	min-height:21px;
	border:0px solid;
}

QComboBox QAbstractItemView::item:selected
{
	background:rgb(51,153,255);
	border:0px solid;
}



/* ==============================QComboBox部分-结束===================================*/

/* ==============================QScrollBar部分-开始===================================*/
 /*滚动条：滑块默认颜色和鼠标悬浮时颜色*/
QScrollBar::handle 
{
	background:rgba(131, 160, 180, 70);
	min-height:15px;
	min-width:8px;
	width:4px;
	border-radius:0px;
	
	margin-top:3px;
	margin-left:3px;
	margin-right:3px;
	margin-bottom:3px;
}

QScrollBar::handle:hover
{
	background:#a2b9d4;
	width:4px;
	border-radius:0px;
}

/*垂直滚动条：添加上下箭头，设置背景及滑块属性，主要出现在弹出窗体中*/


QScrollBar:vertical
{
	border: 0px solid transparent;
	background:rgba(255, 255, 255, 100);
	width: 16px;
}
QScrollBar::add-line:vertical 
{
	image:url();
	border: 0px;
	height: 0px;
}

QScrollBar::sub-line:vertical 
{
	image:url();
	border: 0px;
	height: 0px;
} 

QScrollBar::add-line:vertical:hover 
{
	image:url();
	border: 0px;
	height: 0px;
}

QScrollBar::sub-line:vertical:hover
{
	image:url();
	border: 0px;
	height: 0px;
}
 /*水平滚动条：隐藏左右箭头，设置背景、滑块风格*/ 
QScrollBar:horizontal 
{
	border: 0px solid transparent;
	background:rgba(255, 255, 255, 100);
	height: 16px;
}

QScrollBar::add-line:horizontal 
{
	image:url();
	border: 0px;
	height: 0px;
}
QScrollBar::sub-line:horizontal
{
	subcontrol-position: left;
	image:url();
	border: 0px;
	height: 0px;
}

QScrollBar::add-line:horizontal:hover 
{
	image:url();
	border: 0px;
	height: 0px;
}

QScrollBar::sub-line:horizontal:hover
{
	image:url();
	border: 0px;
	height: 0px;
}

QScrollArea
{
	border: 0 solid #ecf4f9;
}
/* ==============================QScrollBar部分-结束===================================*/


/* ==============================QTabWidget部分-开始===================================*/
/*左间距26=widget的左16+tab的左padding10*/  
QTabWidget::tab-bar 
{
	left: 0px;
}

QTabWidget
{
	font-family:"微软雅黑";
	font: 14px;
	background-color: transparent;
}

QTabWidget::pane
{
	border:0px solid #adb2b9;;
}

/* QTabBar::tab 
{
	color: #003986;
	background: #e6ecf7;
	border-width: 1px;
	border-top: 1px solid #dae1ee;
	border-bottom: 2px solid #68a3ea; 
} 

QTabBar::tab:selected 
{
	font-size:14px; 
	color: #ffffff; 
	background: #1e6ccc;
	border-bottom:1px solid #68a3ea;
}

QTabBar::tab:!selected
{
	font-size:14px;
	color: #003986; 
	background: #e1effe;
	border-bottom:1px solid #68a3ea;
} */

QTabWidget#CompTabWidget::tab-bar,QTabWidget#AssetTabWidget::tab-bar 
{
	 left: 0px; 
}

/* QTabWidget#tabWidget::tab-bar
{
	color: #ffffff;
	background: rgb(245,168,0);
	border-bottom:2px solid rgb(255,198,0);
} */

/* ==============================QTabWidget部分-结束===================================*/

/* ==============================QGroupBox部分-开始=====================================*/

QGroupBox
{
	border-radius: 0px;
	font-size: 16px;
	border:1px solid #b5c5d5;
	background-color: #ffffff;
	border-top:28px solid #dfe5ef;
}

QGroupBox::title
{
	font-size: 16px;
	color: #002f86;
	subcontrol-origin: margin;
	subcontrol-position: top left;
	left:10px;
	top:5px;
	background-color: transparent;
}

/*QGroupBox未勾选状态，选框图片及背景图片*/
QGroupBox#HRCheckableGroupBox::indicator:unchecked
{
	image: url(theme/huaru/whiteblue/checkable_groupbox_uncheck.png);
}
 /*QGroupBox勾选状态，选框图片及背景图片*/
QGroupBox#HRCheckableGroupBox::indicator:checked 
{
	image: url(theme/huaru/whiteblue/checkable_groupbox_check.png);
}

/*QGroupBox未勾选状态，选框图片及背景图片*/
QGroupBox::indicator:unchecked
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_normal.png);
}
 /*QGroupBox勾选状态，选框图片及背景图片*/
QGroupBox::indicator:checked 
{
	image: url(theme/huaru/whiteblue/checkbox_checked_normal.png);
}
 /*QGroupBox未勾选hover状态，选框图片*/
QGroupBox::indicator:unchecked:hover
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_hover.png);
}
/*QGroupBox勾选hover状态，选框图片及背景图片*/
QGroupBox::indicator:checked:hover
{
	image: url(theme/huaru/whiteblue/checkbox_checked_hover.png);
}
 /*QGroupBox未勾选状态，选框图片*/
QGroupBox::indicator:unchecked:disabled
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_disabled.png);
}
/*QGroupBox勾选状态，选框图片及背景图片*/
QGroupBox::indicator:checked:disabled
{
	image: url(theme/huaru/whiteblue/checkbox_checked_disabled.png);
}
/* ==============================QGroupBox部分-结束=====================================*/

/* ==============================QRadioButton部分-开始===================================*/

QRadioButton
{
	font-family:"微软雅黑";
	font-size: 14px;
	color:#002f86;
	border:0px;
	background-color: rgba(0,0,0,0);
}

QRadioButton:hover
{
	color:#788191;
}

QRadioButton:!enabled
{
	color:#657388;
}

QRadioButton:enabled
{
	color:#002f86;
}

QRadioButton::indicator::unchecked
{
	image: url(theme/huaru/whiteblue/radiobutton_unselected_normal.png);
}

QRadioButton::indicator::checked
{
	image: url(theme/huaru/whiteblue/radiobutton_selected_normal.png);
}
QRadioButton::indicator::unchecked:hover
{
	image: url(theme/huaru/whiteblue/radiobutton_unselected_hover.png);
}

QRadioButton::indicator::checked:hover
{
	image: url(theme/huaru/whiteblue/radiobutton_selected_hover.png);
}
QRadioButton::indicator::unchecked:disabled
{
	image: url(theme/huaru/whiteblue/radiobutton_unselected_disabled.png);
}

QRadioButton::indicator::checked:disabled
{
	image: url(theme/huaru/whiteblue/radiobutton_selected_disabled.png);
}
/* ==============================QRadioButton部分-结束===================================*/


/* ==============================QSpinBox部分-开始======================================*/
QSpinBox,QDoubleSpinBox,QDateTimeEdit,QLineEdit,QTextEdit
{
	background-color: #fbfdff;
	border:1px solid #a3b4cb;
	min-height:20px;
	padding-left:3px;
	font-family:"微软雅黑";
	font-size: 14px;
	color:#657388;
}

QSpinBox:disabled,QDoubleSpinBox:disabled,QDateTimeEdit:disabled,QLineEdit:disabled
{
	background-color: #eaf0f7;
	border:1px solid #b5c5d5;
	color:#bfc5cd;
}

QSpinBox::focus, QDoubleSpinBox::focus, QDateTimeEdit::focus,QLineEdit:focus, QTextEdit:focus,
QSpinBox:hover, QDoubleSpinBox:hover, QDateTimeEdit:hover,QLineEdit:hover, QTextEdit:hover
{
	border:1px solid #1f84ff;
	background-color:#ffffff;
}

QSpinBox::up-button , QDoubleSpinBox::up-button , QDateTimeEdit::up-button
{
	height:8px;
	margin-top:3px;
	subcontrol-origin: border;
	subcontrol-position: top right; /* position at the top right corner */
	image: url(theme/huaru/whiteblue/spinbox_uparrow_normal.png);
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover, QDateTimeEdit::up-button:hover
{
	image: url(theme/huaru/whiteblue/spinbox_uparrow_hover.png);
}

QSpinBox::up-button:disabled, QSpinBox::up-button:off , QDoubleSpinBox::up-button:disabled, QDoubleSpinBox::up-button:off, QDateTimeEdit::up-button:disabled, QDateTimeEdit::up-button:off
{
	subcontrol-position: top right; /* position at the top right corner */
	image: url(theme/huaru/whiteblue/spinbox_uparrow_disabled.png);
}

QSpinBox::down-button , QDoubleSpinBox::down-button  , QDateTimeEdit::down-button
{
	height:8px;
	subcontrol-origin: border;
	margin-bottom:3px;
	subcontrol-position: bottom right; /* position at bottom right corner */
	image: url(theme/huaru/whiteblue/spinbox_downarrow_normal.png);
}
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover, QDateTimeEdit::down-button:hover
{
	image: url(theme/huaru/whiteblue/spinbox_downarrow_hover.png);
}
QSpinBox::down-button:disabled, QSpinBox::down-button:off , QDoubleSpinBox::down-button:disabled, QDoubleSpinBox::down-button:off , QDateTimeEdit::down-button:disabled, QDateTimeEdit::down-button:off
{
	subcontrol-position: bottom right; /* position at the top right corner */
	image: url(theme/huaru/whiteblue/spinbox_downarrow_disabled.png);
}
/* ==============================QSpinBox部分-结束===================================*/

/* ===============================QDateEdit部分-开始===================================*/
/*禁用状态，设置背景色*/
/* QDateEdit:disabled
{
	background-color:rgb(47,47,47);
	border:0;
}*/
/*点击组合框文字部分，下拉菜单出现时，组合框边框变色*/
QDateEdit:!editable:on
{
	border:1px solid #1b5982;
}
/*下拉箭头为图片*/
QDateEdit::drop-down
{
	image:url(theme/huaru/whiteblue/dateedit_downarrow_normal.png);
}
/*点击下拉箭头，下拉菜单出现时，箭头无边框*/
QDateEdit::drop-down:!editable:pressed
{
	border:0;
}
/*鼠标经过状态下拉箭头图片*/
QDateEdit::drop-down:hover
{
	image:url(theme/huaru/whiteblue/dateedit_downarrow_hover.png);
}

/*禁用状态下拉箭头图片*/
QDateEdit::drop-down:disabled
{
	image:url(theme/huaru/whiteblue/dateedit_downarrow_disabled.png);
}
/* ===============================QDateEdit部分-结束===================================*/

 /* ==============================QCheckBox-开始======================================*/
 /*QCheckBox未勾选状态，选框图片*/
QCheckBox::indicator:unchecked
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_normal.png);
}
 /*QCheckBox勾选状态，选框图片及背景图片*/
QCheckBox::indicator:checked 
{
	image: url(theme/huaru/whiteblue/checkbox_checked_normal.png);
}
 /*QCheckBox未勾选hover状态，选框图片*/
 QCheckBox::indicator:unchecked:hover
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_hover.png);
}
 /*QCheckBox勾选hover状态，选框图片及背景图片*/
QCheckBox::indicator:checked:hover
{
	image: url(theme/huaru/whiteblue/checkbox_checked_hover.png);
}
 /*QCheckBox未勾选状态，选框图片*/
QCheckBox::indicator:unchecked:disabled
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_disabled.png);
}
 /*QCheckBox勾选状态，选框图片及背景图片*/
QCheckBox::indicator:checked:disabled
{
	image: url(theme/huaru/whiteblue/checkbox_checked_disabled.png);
}
/*部分选中*/
 QCheckBox::indicator:indeterminate
{
	image: url(theme/huaru/whiteblue/checkbox_partiallychecked_normal.png);
}
 QCheckBox::indicator:indeterminate:hover
{
	image: url(theme/huaru/whiteblue/checkbox_partiallychecked_hover.png);
}
QCheckBox::indicator:indeterminate:disabled
{
	image: url(theme/huaru/whiteblue/checkbox_partiallychecked_disabled.png);
}

QCheckBox
{
	font-family:"微软雅黑";
	font-size: 14px;
	color:#002f86;
	background-color:transparent;
}
/*鼠标经过，字体颜色*/
QCheckBox:hover
{
	color:#002f86;
}
/*禁用状态下，字体颜色*/
QCheckBox:disabled
{
	color:#657388;
}

/* ==============================QCheckBox-结束======================================*/

/* QMainWindow
{
	background-color: rgb(37,37,37);
} */

/* ==============================QDockWidget-开始===================================*/
QDockWidget
{
	font-family:"微软雅黑";
	border: 2px solid #687069;
	font-size:18px;
	color:#b5c4c8;
	titlebar-close-icon: url(theme/huaru/whiteblue/dock_titlebarcloseicon.png);
	titlebar-normal-icon: url(theme/huaru/whiteblue/dock_titlebarnormalicon.png);
}

QDockWidget::title
{
	text-align: left; 
	background: #006fe0;
	width:354px;
	border-top: 1px solid #5f6f77;
	border-bottom: 1px solid #5f6f77;
	padding-top:7px;
	padding-bottom:6px;
	padding-left: 10px; 
}

/* ==============================QDockWidget-结束===================================*/

/* ==============================QTreeView-开始-同QTreeWidget==================================*/
/*所有树：文字大小为16*/
QTreeView
{
	font-size:16px;
	show-decoration-selected:1;
	background-color:#ffffff;
	alternate-background-color:#f0f3f8;;
	color:#002f86;
	border: 1px solid #dee6ee;
}

/*所有树：条目列高为27*/
QTreeView::item
{
	height:29px;
	color:#002f86;
}

QTreeView::item:!enabled
{
	height: 29px;
	color:#a4a9b3;
}

QTreeView::branch
{
	background-color:transparent;
}

/* dockWidget中的树：鼠标悬浮于条目上时，该条目背景颜色变为灰色 */
QTreeView::item:hover,QTreeView::branch:hover
{
	background: #fff3dd;
	border: 1px solid #fff3dd;
	border-left: 0px solid transparent;
	border-right: 0px solid transparent;
}

/*所有树：条目被选中时背景颜色变为浅蓝,文字颜色*/
QTreeView::item:selected,QTreeView::branch:selected  
{
	background: #ffc45d;
	border: 1px solid #ffc45d;

	border-left: 0px solid transparent;
	border-right: 0px solid transparent;
}

QTreeView::branch:closed:has-children:!has-siblings,
QTreeView::branch:closed:has-children:has-siblings
{
	image: url(theme/huaru/whiteblue/treewidget_close.png);
	image-position:right;
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings
{
	image: url(theme/huaru/whiteblue/treewidget_open.png);
	image-position:right;
}
QTreeView>QHeaderView::down-arrow 
{
	image: url(theme/huaru/whiteblue/icons/下拉按钮--正常.png);
}

QTreeView>QHeaderView::up-arrow 
{
	image: url(theme/huaru/whiteblue/icons/向上箭头--正常.png);
}

QTreeView>QHeaderView::down-arrow:hover 
{
	image: url(theme/huaru/whiteblue/icons/下拉按钮--滑过.png);
}

QTreeView>QHeaderView::up-arrow:hover
{
	image: url(theme/huaru/whiteblue/icons/向上箭头--滑过.png);
}

QTreeView>QHeaderView::section 
{
	font-family:"微软雅黑";
	font-size: 16px;
	background-color: #e1effe;
	padding-left: 9px;
	padding-right: 9px;
	border: 1px solid #599ae8;
	border-bottom: 2px solid #68a3ea;
	border-top: 1px #dee6f3;
	border-left: 1px #68a3ea;
	height:28px;
	width:30px;
}
QTreeView >QHeaderView::section:first 
{
	border-left: 0px solid #599ae8;
}

QTreeView >QHeaderView::section:last 
{
	border-right: 0px solid #599ae8;
}

/*Item未勾选状态，选框图片及背景图片*/
QTreeView::indicator:unchecked
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_normal.png);
}
/*Item勾选状态，选框图片及背景图片*/
QTreeView::indicator:checked 
{
	image: url(theme/huaru/whiteblue/checkbox_checked_normal.png);
}
/*Item未勾选hover状态，选框图片*/
QTreeView::indicator:unchecked:hover
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_hover.png);
}
/*Item勾选hover状态，选框图片及背景图片*/
QTreeView::indicator:checked:hover
{
	image: url(theme/huaru/whiteblue/checkbox_checked_hover.png);
}

/*Item未勾选状态，选框图片*/
QTreeView::indicator:unchecked:disabled
{
	image: url(theme/huaru/whiteblue/checkbox_unchecked_disabled.png);
}

/*Item勾选状态，选框图片及背景图片*/
QTreeView::indicator:checked:disabled
{
	image: url(theme/huaru/whiteblue/checkbox_checked_disabled.png);
}

/*实现条目打开和关闭时左边箭头变换显示效果*/

QTreeView::branch:closed:has-children:!has-siblings,
QTreeView::branch:closed:has-children:has-siblings
{
	image: url(theme/huaru/whiteblue/treewidget_close.png) ;
	image-position:right;/*图片右对齐，以留出左侧空间*/
}

QTreeView::branch:open:has-children:!has-siblings,
QTreeView::branch:open:has-children:has-siblings  
{
	image: url(theme/huaru/whiteblue/treewidget_open.png) ;
	image-position:right;
}

/* ==============================QTreeView-结束-同QTreeWidget==================================*/

