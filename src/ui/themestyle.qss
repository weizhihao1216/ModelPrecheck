/* ==============================QSlider-开始=================================*/

QSlider::handle:horizontal
{
	background-color:#bed5ee;
	width: 8px;
	border-radius:4px;
	margin:-5px 0;
}

QSlider::groove:horizontal
{
	background-color:#7c9bb4;
	height:4px;
}


/*滑动条设置*/
QSlider
{
	background-color:transparent;
}

/*进度条*/
QSlider::groove:horizontal
{
	border-radius:3px;
	height:6px;
}
/*滑动块设置水平*/
QSlider::handle:horizontal
{
	border:0px;
	height: 16px;
	width:16px;
	background:transparent;
	image:url(theme/huaru/whiteblue/XScenario/进度控制/移动按钮.png);
}
/*滑过水平*/
QSlider::sub-page:horizontal
{
	border-radius:3px;
	background-color: qlineargradient(spread:pad, x1:1, y1:0.75, x2:1, y2:0, stop:0 #0270c7, stop:1 #008df9);
}
/*为滑过水平*/
QSlider::add-page:horizontal
{
	border-radius:3px;
	background-color: qlineargradient(spread:pad, x1:1, y1:0.75, x2:1, y2:0, stop:0 #96abc4, stop:1 #9ab1cd);
}
/*滑动块设置竖直*/
QSlider::handle:vertical
{
	border:0px;
	height: 16px;
	width:16px;
	background:transparent;
	image:url(theme/huaru/whiteblue/XScenario/进度控制/移动按钮.png);
}
/*滑过竖直*/
QSlider::sub-page:vertical
{
	border-radius:3px;
	background-color: qlineargradient(spread:pad, x1:0.478591, y1:0, x2:1, y2:0, stop:0 #0270c7, stop:1 #008df9);
}
/*为滑过竖直*/
QSlider::add-page:vertical
{
	border-radius:3px;
	background-color: qlineargradient(spread:pad, x1:0.478591, y1:0, x2:1, y2:0, stop:0 #96abc4, stop:1 #9ab1cd);
}
/* ==============================QSlider-结束=================================*/

/* ==============================QToolButton特化-开始=================================*/
QToolButton#pushButton_Save,
QToolButton#AddButton
{
	min-height:4px;
	height:21px;
	padding-left:10px;
	padding-right:10px;
	background-color: #585858;
	font-size:12px;
	font-family:"Microsoft YaHei UI";
	color: rgb(209,209,209);
}
/*按钮默认正常*/
QToolButton#pushButton_Save,
QToolButton#AddButton,
QToolButton#MotionButton,
QToolButton#DPButton
{
	border-width:2px 1px 1px 2px;
	border-image: url(theme/huaru/whiteblue/popupwidget_pushbutton_normal.png) 2 1 1 2 repeat repeat; 
}
/*鼠标经过QToolButton，文字变色*//*按钮默认选中*/
QToolButton#pushButton_Save:hover,
QToolButton#AddButton:hover,
QToolButton#MotionButton:hover,
QToolButton#DPButton:hover
{
	color: rgb(255,255,255);
	border-width:2px 1px 1px 2px;
	border-image: url(theme/huaru/whiteblue/popupwidget_pushbutton_hover.png) 2 1 1 2 repeat repeat; 
}

/*鼠标点击QToolButton，文字变色*//*按钮默认选中*/
QToolButton#pushButton_Save:pressed,
QToolButton#AddButton:pressed,
QToolButton#MotionButton:pressed,
QToolButton#DPButton:pressed
{
	border-width:2px 1px 1px 2px;
	border-image: url(theme/huaru/whiteblue/popupwidget_pushbutton_pressed.png) 2 1 1 2 repeat repeat; 
}
QToolButton#pushButton_Save:disabled,
QToolButton#AddButton:disabled,
QToolButton#MotionButton:disabled,
QToolButton#DPButton:disabled
{
	color:#666666;
	border-width:2px 1px 1px 2px;
	border-image: url(theme/huaru/whiteblue/popupwidget_pushbutton_disabled.png) 2 1 1 2 repeat repeat; 
}
QToolButton#pushButton_Save::menu-button,
QToolButton#AddButton:menu-button,
QToolButton#MotionButton:menu-button,
QToolButton#DPButton:menu-button
{
	width: 10px;
	margin-left: 4px;
	border-top-right-radius: 0px;
	border-bottom-right-radius: 0px;
}

QToolButton#pushButton_Save::menu-button:hover,
QToolButton#AddButton::menu-button:hover,
QToolButton#MotionButton::menu-button:hover,
QToolButton#DPButton::menu-button:hover
{
	border:1px solid #000000;;
}

QToolButton#pushButton_Save::menu-button:pressed,
QToolButton#AddButton::menu-button:pressed,
QToolButton#MotionButton::menu-button:pressed,
QToolButton#DPButton::menu-button:pressed
{
	border:1px solid #000000;
	background-color: rgb(37, 37, 37);
}

QToolButton#pushButton_Save::menu-arrow,
QToolButton#AddButton::menu-arrow,
QToolButton#AddButton::menu-arrow,
QToolButton#MotionButton::menu-arrow,
QToolButton#DPButton::menu-arrow
{
	image: url(theme/huaru/whiteblue/combobox_downarrow_hover.png);
}
/* ==============================QToolButton特化-结束=================================*/
