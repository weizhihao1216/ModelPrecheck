INCPATH       = -I. -I. -I..\scintilla\include -I..\scintilla\lexlib -I..\scintilla\src -ID:\Qt\5.14.2\msvc2017_64\include -ID:\Qt\5.14.2\msvc2017_64\include\QtPrintSupport -ID:\Qt\5.14.2\msvc2017_64\include\QtWidgets -ID:\Qt\5.14.2\msvc2017_64\include\QtGui -ID:\Qt\5.14.2\msvc2017_64\include\QtANGLE -ID:\Qt\5.14.2\msvc2017_64\include\QtCore -Idebug -I/include -ID:\Qt\5.14.2\msvc2017_64\mkspecs\win32-msvc 
LIBAPP        = lib /NOLOGO
LIBFLAGS      = 
QMAKE         = D:\Qt\5.14.2\msvc2017_64\bin\qmake.exe
DEL_FILE      = del
CHK_DIR_EXISTS= if not exist
MKDIR         = mkdir
COPY          = copy /y
COPY_FILE     = copy /y
COPY_DIR      = xcopy /s /q /y /i
INSTALL_FILE  = copy /y
INSTALL_PROGRAM = copy /y
INSTALL_DIR   = xcopy /s /q /y /i
QINSTALL      = D:\Qt\5.14.2\msvc2017_64\bin\qmake.exe -install qinstall
QINSTALL_PROGRAM = D:\Qt\5.14.2\msvc2017_64\bin\qmake.exe -install qinstall -exe
DEL_FILE      = del
SYMLINK       = $(QMAKE) -install ln -f -s
DEL_DIR       = rmdir
MOVE          = move
IDC           = idc
IDL           = midl
ZIP           = zip -r -9
DEF_FILE      = 
RES_FILE      = 
SED           = $(QMAKE) -install sed
MOVE          = move

