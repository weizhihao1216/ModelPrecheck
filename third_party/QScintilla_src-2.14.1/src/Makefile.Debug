	@if not exist D:$(INSTALL_ROOT)\Qt\5.14.2\msvc2017_64\lib mkdir D:$(INSTALL_ROOT)\Qt\5.14.2\msvc2017_64\lib & if not exist D:$(INSTALL_ROOT)\Qt\5.14.2\msvc2017_64\lib exit 1
	-$(INSTALL_FILE) $(DESTDIR_TARGET) D:$(INSTALL_ROOT)\Qt\5.14.2\msvc2017_64\lib\$(TARGET)
